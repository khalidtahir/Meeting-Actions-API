# Copy this file to .env and set your values.
# Do not commit .env (it is gitignored).

# OpenAI API key – required for real AI extraction and reconciliation.
# Without it, the app runs in mock mode (deterministic placeholder responses).
OPENAI_API_KEY=

# Optional: database URL (default: sqlite in current directory)
# DATABASE_URL=sqlite:///./meetings.db

# Optional: AI provider (openai or anthropic) and model
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
